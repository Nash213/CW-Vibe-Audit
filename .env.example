# Copy to .env (git-ignored) and fill in. Never commit .env.
# Which backend the agent runner uses: azure (default) | vertex | apikey
VIBE_AGENT_BACKEND=azure
# azure: Azure AI Foundry resource endpoint, key and deployment name
# (portal: resource -> Resource Management -> Keys and Endpoint)
AZURE_FOUNDRY_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com/
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=gpt-5.4-mini
# vertex (fallback, needs paid billing): Google Cloud project id
# (auth: gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=
# apikey (fallback): Gemini Developer API key from AI Studio
GEMINI_API_KEY=
